# ZFARM Environment Configuration Template
# Mode: Local Demo operates without any credentials.
# For Connected Mode with Firebase & Server AI Provider, fill in the values below:

# App Mode ('demo' | 'connected')
VITE_APP_MODE=demo

# Firebase Web Client Configuration (Safe for client bundle)
VITE_FIREBASE_API_KEY=AIzaSyFakeKeyForZFARMEnvironment
VITE_FIREBASE_AUTH_DOMAIN=zfarm-srilanka.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zfarm-srilanka
VITE_FIREBASE_STORAGE_BUCKET=zfarm-srilanka.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Server-Side Secure Endpoints (NEVER expose secret API keys on browser frontend)
# GoviyaAI Agronomy Backend Service URL:
VITE_GOVIYA_AI_API_ENDPOINT=https://api.zfarm.gov.lk/v1/goviya-ai
