---
import SmartCityIcon from "./icons/SmartCityIcon.svelte";
import SmartAgricultureIcon from "./icons/SmartAgriculture.svelte";
import TechnologyIcon from "./icons/TechnologyIcon.svelte";
import CleanEnergyIcon from "./icons/CleanEnergyIcon.svelte";
---

<aside class="features">
  <!-- Smart City -->
  <div class="feature">
    <SmartCityIcon />
    <strong>Smart City</strong>
    <p>
      Connected buildings and smart infrastructure that make everyday life
      easier.
    </p>
  </div>

  <!-- Smart Agriculture -->
  <div class="feature">
    <SmartAgricultureIcon />
    <strong>Smart Agriculture</strong>
    <p>
      Modern farming methods that help grow food efficiently while protecting
      nature.
    </p>
  </div>

  <!-- Technology -->
  <div class="feature">
    <TechnologyIcon />
    <strong>Technology</strong>
    <p>
      AI, IoT, automation, and smart systems that turn ideas into practical
      solutions.
    </p>
  </div>

  <!-- Clean Energy -->
  <div class="feature">
    <CleanEnergyIcon />
    <strong>Clean Energy</strong>
    <p>
      Renewable energy solutions that help create a cleaner and more sustainable
      future.
    </p>
  </div>
</aside>
