---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.vue";
---

<Layout title="404 - Not Found | Tech Agroa">
  <Header />
  <main class="min-h-screen w-full px-4 py-5 text-center text-[var(--text)]">
    <div class="mx-auto w-full max-w-[1100px]">
      <section
        class="mx-auto flex min-h-[500px] w-full max-w-[650px] flex-col items-center justify-center rounded-[28px] border border-[var(--border)] bg-[var(--card)] px-6 py-12 shadow-[0_15px_50px_var(--shadow)] sm:px-10"
      >
        <!-- Error number -->
        <div
          class="text-[clamp(5rem,18vw,10rem)] font-extrabold leading-none text-[var(--accent)] opacity-90"
        >
          404
        </div>

        <!-- Title -->
        <h2
          class="mt-5 text-3xl font-bold text-[var(--text)] sm:text-4xl md:text-5xl"
        >
          Page Not Found
        </h2>

        <!-- Description -->
        <p class="mx-auto mt-3 max-w-[600px] leading-7 text-[var(--muted)]">
          Sorry, the page you are looking for doesn't exist or may have been
          moved.
        </p>

        <!-- Button -->
        <a
          href="/"
          class="mt-8 inline-flex items-center justify-center rounded-full bg-[var(--accent)] px-6 py-3 font-semibold text-white no-underline transition duration-200 hover:-translate-y-0.5 hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[var(--accent)] focus:ring-offset-2"
        >
          ← Back to Home
        </a>
      </section>
    </div>
  </main>
  <Footer/>
</Layout>
