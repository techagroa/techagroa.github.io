---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.vue";
---

<Layout title="500 - Server Error | Tech Agroa">
  <Header />
  <main class="min-h-screen w-full px-4 py-5 text-center text-[var(--text)]">
    <div class="mx-auto w-full max-w-[1100px]">
      <section
        class="mx-auto flex min-h-[500px] w-full max-w-[650px] flex-col items-center justify-center rounded-[28px] border border-[var(--border)] bg-[var(--card)] px-6 py-12 shadow-[0_15px_50px_var(--shadow)] sm:px-10"
      >
        <!-- Error number -->
        <div
          class="text-[clamp(5rem,18vw,10rem)] font-extrabold leading-none text-[var(--accent)] opacity-90"
        >
          500
        </div>

        <!-- Title -->
        <h2
          class="mt-5 text-3xl font-bold text-[var(--text)] sm:text-4xl md:text-5xl"
        >
          Something Went Wrong
        </h2>

        <!-- Description -->
        <p class="mx-auto mt-3 max-w-[600px] leading-7 text-[var(--muted)]">
          We're sorry, but something went wrong on our side.
        </p>
        <p class="mx-auto mt-3 max-w-[600px] leading-7 text-[var(--muted)]">
          Please try again in a moment.
        </p>

        <!-- Actions -->
        <div
          class="mt-8 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row"
        >
          <!-- Retry -->
          <button
            type="button"
            onclick="window.location.reload()"
            class="inline-flex min-h-[46px] w-full cursor-pointer items-center justify-center rounded-full border-0 bg-[var(--accent)] px-6 py-3 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[var(--accent)] focus:ring-offset-2 sm:w-auto"
          >
            ↻ Try Again
          </button>

          <!-- Home -->
          <a
            href="/"
            class="inline-flex min-h-[46px] w-full items-center justify-center rounded-full border border-[var(--border)] bg-transparent px-6 py-3 font-semibold text-[var(--text)] no-underline transition duration-200 hover:-translate-y-0.5 hover:opacity-90 sm:w-auto"
          >
            ← Back to Home
          </a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
